<Window x:Class="WPF_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_App"
        xmlns:vm="clr-namespace:WPF_App.ViewModels"
        xmlns:infra="clr-namespace:WPF_App.Infrastructure"
        mc:Ignorable="d"
        Title="ML Heroes" Height="720" Width="1180" MinHeight="560" MinWidth="850" Background="#F4F7FB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#344054"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="#C7D2E0"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#176B42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5EAF1"/>
            <Setter Property="Foreground" Value="#14213D"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5EAF1"/>
            <Setter Property="Foreground" Value="#14213D"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <DataTemplate DataType="{x:Type vm:HeroesViewModel}">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontSize="26" FontWeight="SemiBold" Foreground="#14213D" Margin="0,0,0,18"/>
                        <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Style="{StaticResource InputStyle}"/>
                        <TextBlock Text="Image URL" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Style="{StaticResource InputStyle}"/>
                        <TextBlock Text="Roles" Style="{StaticResource LabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding Roles}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,22,8" FontSize="14"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource InputStyle}"/>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <DockPanel>
                        <Button Content="+  Add Hero" Command="{Binding AddCommand}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"/>
                        <TextBlock Text="Heroes" FontSize="26" FontWeight="SemiBold" Foreground="#14213D"/>
                    </DockPanel>
                </Grid>
                <Border Grid.Row="1" Background="#E8F5EE" Padding="12" Margin="0,16,0,12" Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#176B42"/>
                </Border>
                <Border Grid.Row="1" Background="#FDECEC" Padding="12" Margin="0,16,0,12" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap"/>
                </Border>
                <ListView Grid.Row="2" ItemsSource="{Binding Heroes}" Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibility}}" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Image" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImageUrl}" Width="78" Height="64" Stretch="UniformToFill"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                            <GridViewColumn Header="Roles" DisplayMemberBinding="{Binding Roles}" Width="170"/>
                            <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="390"/>
                            <GridViewColumn Header="Actions" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Update" Command="{Binding UpdateCommand}" Style="{StaticResource SmallButtonStyle}"/>
                                            <Button Content="Delete" Style="{StaticResource SmallButtonStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolesViewModel}">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontSize="26" FontWeight="SemiBold" Foreground="#14213D" Margin="0,0,0,18"/>
                        <TextBlock Text="Role" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Style="{StaticResource InputStyle}"/>
                        <TextBlock Text="Logo URL" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding LogoUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Style="{StaticResource InputStyle}"/>
                        <TextBlock Text="Primary Function" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding PrimaryFunction, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Style="{StaticResource InputStyle}"/>
                        <TextBlock Text="Key Attributes" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding KeyAttributes, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Style="{StaticResource InputStyle}"/>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#B42318" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <DockPanel>
                        <Button Content="+  Add Role" Command="{Binding AddCommand}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"/>
                        <TextBlock Text="Roles" FontSize="26" FontWeight="SemiBold" Foreground="#14213D"/>
                    </DockPanel>
                </Grid>
                <Border Grid.Row="1" Background="#E8F5EE" Padding="12" Margin="0,16,0,12" Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#176B42"/>
                </Border>
                <Border Grid.Row="1" Background="#FDECEC" Padding="12" Margin="0,16,0,12" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap"/>
                </Border>
                <ListView Grid.Row="2" ItemsSource="{Binding Roles}" Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibility}}" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Logo" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding LogoUrl}" Width="64" Height="54" Stretch="UniformToFill"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Role" DisplayMemberBinding="{Binding RoleName}" Width="150"/>
                            <GridViewColumn Header="Primary Function" DisplayMemberBinding="{Binding PrimaryFunction}" Width="260"/>
                            <GridViewColumn Header="Key Attributes" DisplayMemberBinding="{Binding KeyAttributes}" Width="330"/>
                            <GridViewColumn Header="Actions" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Update" Command="{Binding UpdateCommand}" Style="{StaticResource SmallButtonStyle}"/>
                                            <Button Content="Delete" Style="{StaticResource SmallButtonStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#14213D">
            <DockPanel Margin="28,0">
                <TextBlock Text="ML HEROES" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Heroes" Command="{Binding ShowHeroesCommand}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Roles" Command="{Binding ShowRolesCommand}" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
